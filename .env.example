# Copy to .env and fill in. Never commit .env.
MONGODB_URI=
MONGODB_DB=proxylens
EMBEDDING_PROVIDER=local            # local | vertex
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
GCP_PROJECT_ID=
GCP_REGION=asia-south1
TEACHER_PROVIDER=openrouter         # openrouter | vertex
TEACHER_MODEL=                      # e.g. an OpenRouter model id such as google/gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TEACHER_MAX_OUTPUT_TOKENS=2048
TEACHER_STRUCTURED_OUTPUT=true      # false if the model rejects strict json_schema
TEACHER_REASONING_EFFORT=low        # minimal | low | medium | high | empty = model default
STUDENT_PROVIDER=local_gguf         # local_gguf | vertex | base_hf
STUDENT_GGUF_REPO=deepeshkatudia/proxylens-qwen3b-gguf-v1
STUDENT_GGUF_FILE=proxylens-q4_k_m.gguf
STUDENT_GGUF_PATH=                  # optional local .gguf (skips the HF download)
STUDENT_CONSTRAINED_JSON=true
# API pipeline extractor: student (fine-tuned GGUF + teacher fallback) or teacher (fast on a laptop)
PIPELINE_EXTRACTOR=student
MAX_UPLOAD_MB=25
HF_TOKEN=
API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=text                     # text | json (one JSON object per line, for Cloud Logging)
PRELOAD_MODELS=false                # true: load BGE + the student at startup, not on first use
